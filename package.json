{
  "name": "turf-duel",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "packages/engine",
    "packages/bot",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=packages/engine && npm run build --workspace=packages/bot",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace=packages/engine && npm run build --workspaces --if-present",
    "server": "npm run start --workspace=packages/server",
    "sim:bandwidth": "npm run bandwidth --workspace=packages/server"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "5.0.3"
  }
}
